#
# Writes THIRD_PARTY_NOTICES.md: an index of every Go dependency followed by the
# verbatim text of each license. Two surfaces — the modules linked into the
# commands under ./cmd (read offline from vendor/), and the build toolchain in
# tools/go.mod (read from the module cache, since tools/ is not vendored).
# Standard library packages are excluded; the Go distribution covers them.
#
# Why wrap go-licenses: it resolves one platform, the host's, and build-tagged
# sources pull in different dependencies per platform. Running it once yields a
# file that is incomplete (missing every non-host platform) and host-dependent,
# so a freshness gate would flap between macOS and Linux CI. There is no
# multi-GOOS union mode, so this runs it per target, unions, and sorts with
# LC_ALL=C for byte-identical output anywhere.
#
# Requires go (versions.mk) and go-licenses (tools/go.mod; make install-tools).

set -euo pipefail

OUTPUT="${OUTPUT:-THIRD_PARTY_NOTICES.md}"
LICENSES_DIR="${LICENSES_DIR:-.licenses-cache}"

# ./cmd/... is exactly what 'make cmds' builds (CMDS is a wildcard over ./cmd/*,
# and the Dockerfile builds via 'make cmds'), so this tracks the build rather
# than a hand-kept list. Scoping here rather than ./... drops the e2e suite,
# which is in this module but never shipped. It over-includes gpuop-cfg, a build
# helper that is not shipped either; listing slightly too much is the safe
# direction for a notices file, omitting is not.
PACKAGES=("./cmd/...")

TOOLS_DIR="${TOOLS_DIR:-tools}"
TOOLS_FILE="${TOOLS_DIR}/tools.go"

if ! command -v go >/dev/null 2>&1; then
    echo "ERROR: go is not installed." >&2
    exit 1
fi

# Prefer the repo-local copy so the version pinned in tools/go.mod is what runs.
# Absolute, because the toolchain pass below runs from ${TOOLS_DIR}.
if [[ -x "./bin/go-licenses" ]]; then
    GO_LICENSES="${PWD}/bin/go-licenses"
elif command -v go-licenses >/dev/null 2>&1; then
    GO_LICENSES="$(command -v go-licenses)"
else
    echo "ERROR: go-licenses is not installed." >&2
    echo "Install it with 'make install-tools'." >&2
    exit 1
fi

if [[ ! -f "${TOOLS_FILE}" ]]; then
    echo "ERROR: ${TOOLS_FILE} not found — run 'make notices' from the repo root." >&2
    exit 1
fi

# Some licenses are Markdown and contain fenced blocks of their own, which close
# a fixed ``` fence early and invert every block after it. CommonMark allows a
# longer fence, so use one backtick more than the longest run in the file.
fence_for() {
    local file="$1" longest
    longest=$(grep -oE '`+' "${file}" 2>/dev/null \
        | awk '{ if (length($0) > m) m = length($0) } END { print m+0 }')
    local width=$(( longest + 1 ))
    (( width < 3 )) && width=3
    printf '%*s' "${width}" '' | tr ' ' '`'
}

# The tree is rebuilt each run, so stale copies go first. Guard the override:
# an empty, '/', '.' or '..' value would make this 'rm -rf' catastrophic.
case "${LICENSES_DIR}" in
    ""|"/"|"."|"..")
        echo "ERROR: refusing to 'rm -rf' unsafe LICENSES_DIR='${LICENSES_DIR}'." >&2
        exit 1
        ;;
esac
rm -rf "${LICENSES_DIR}"
mkdir -p "${LICENSES_DIR}"

# Excluded below: this is a *third-party* notices file. Does not vary by
# platform, so compute once.
LOCAL_MODULE=$(go list -m 2>/dev/null || true)
if [[ -z "${LOCAL_MODULE}" ]]; then
    echo "ERROR: could not determine local module path via 'go list -m'." >&2
    exit 1
fi

# Read from vendor/ so this stays offline and matches what is built. CGO is off
# for every released binary, and disabling it here also lets go-licenses
# cross-list each platform without a C toolchain.
export GOFLAGS="-mod=vendor"
export CGO_ENABLED=0

# Must match the platforms the image is released for; the guard below fails the
# run on drift, so a new target cannot silently yield an incomplete file. Kept
# explicit rather than derived so it stays greppable.
PLATFORMS=(
    "linux/amd64"
    "linux/arm64"
)

MULTI_ARCH_MK="${MULTI_ARCH_MK:-multi-arch.mk}"
if [[ ! -f "${MULTI_ARCH_MK}" ]]; then
    echo "ERROR: ${MULTI_ARCH_MK} not found — run 'make notices' from the repo root." >&2
    exit 1
fi
expected_platforms=$(sed -n 's/^DOCKER_BUILD_PLATFORM_OPTIONS[[:space:]]*?*=[[:space:]]*--platform=//p' \
    "${MULTI_ARCH_MK}" | tr ',' '\n' | sed '/^$/d' | LC_ALL=C sort -u)
if [[ -z "${expected_platforms}" ]]; then
    echo "ERROR: could not read DOCKER_BUILD_PLATFORM_OPTIONS from ${MULTI_ARCH_MK}." >&2
    exit 1
fi
actual_platforms=$(printf '%s\n' "${PLATFORMS[@]}" | LC_ALL=C sort -u)
if [[ "${expected_platforms}" != "${actual_platforms}" ]]; then
    echo "ERROR: the PLATFORMS matrix is out of sync with ${MULTI_ARCH_MK}." >&2
    echo "Update the PLATFORMS array in tools/generate-notices to match the released targets." >&2
    echo "  matrix (PLATFORMS): $(echo "${actual_platforms}" | paste -sd ' ' -)" >&2
    echo "  image platforms:    $(echo "${expected_platforms}" | paste -sd ' ' -)" >&2
    exit 1
fi

# Explicit mktemp templates: macOS mktemp ignores TMPDIR without one and
# allocates under confstr(_CS_DARWIN_USER_TEMP_DIR), which makes the scratch
# location unoverridable in sandboxed environments.
SAVE_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/gpu-operator-notices.XXXXXX")"
COMBINED_CSV="$(mktemp "${TMPDIR:-/tmp}/gpu-operator-notices-csv.XXXXXX")"
INDEX_FILE="$(mktemp "${TMPDIR:-/tmp}/gpu-operator-notices-idx.XXXXXX")"
TOOLS_CSV="$(mktemp "${TMPDIR:-/tmp}/gpu-operator-notices-tools-csv.XXXXXX")"
TOOLS_INDEX="$(mktemp "${TMPDIR:-/tmp}/gpu-operator-notices-tools-idx.XXXXXX")"
trap 'rm -rf "${SAVE_ROOT}"; rm -f "${COMBINED_CSV}" "${INDEX_FILE}" "${TOOLS_CSV}" "${TOOLS_INDEX}"' EXIT

for platform in "${PLATFORMS[@]}"; do
    goos="${platform%/*}"
    goarch="${platform#*/}"
    echo "Collecting licenses for ${goos}/${goarch}..." >&2

    # 'go list std' is GOOS-dependent (syscall/js is wasm-only), so recompute
    # per target. --ignore takes comma-separated package path prefixes.
    stdlib_ignore=$(GOOS="${goos}" GOARCH="${goarch}" go list std 2>/dev/null \
        | cut -d'/' -f1 | LC_ALL=C sort -u | paste -sd ',' -)
    ignore="${stdlib_ignore},${LOCAL_MODULE}"

    # Nothing beyond stdlib and the local module is ignored: the notices file
    # must include every distributed dependency, including restricted-license
    # ones that a policy check would treat separately.
    platform_save="${SAVE_ROOT}/${goos}_${goarch}"
    GOOS="${goos}" GOARCH="${goarch}" "${GO_LICENSES}" save "${PACKAGES[@]}" \
        --save_path="${platform_save}" \
        --force \
        --ignore="${ignore}"

    # Union: license text is identical across platforms so overwrites are no-ops,
    # and single-platform modules survive. 'cp -R src/.' copies contents in place.
    cp -R "${platform_save}/." "${LICENSES_DIR}/"

    GOOS="${goos}" GOARCH="${goarch}" "${GO_LICENSES}" csv "${PACKAGES[@]}" \
        --ignore="${ignore}" \
        >> "${COMBINED_CSV}"
done

# tools.go carries a 'tools' build tag and imports main packages, so it cannot be
# listed as a package; read the pinned paths out of it as install-tools does.
TOOL_PKGS=()
while IFS= read -r pkg; do
    [[ -n "${pkg}" ]] && TOOL_PKGS+=("${pkg}")
done < <(grep -E '^[[:space:]]*_ "' "${TOOLS_FILE}" | sed 's/.*"\(.*\)".*/\1/')

if (( ${#TOOL_PKGS[@]} == 0 )); then
    echo "ERROR: no tool imports found in ${TOOLS_FILE}." >&2
    exit 1
fi

# Wider than the runtime matrix: these are host tools, built on developer
# laptops as well as CI, so resolving only the host graph would make the output
# differ between macOS and Linux.
TOOLCHAIN_PLATFORMS=(
    "linux/amd64"
    "linux/arm64"
    "darwin/amd64"
    "darwin/arm64"
)

TOOLS_SAVE_ROOT="${SAVE_ROOT}/tools"
mkdir -p "${LICENSES_DIR}/.tools"
(
    cd "${TOOLS_DIR}"
    # shellcheck disable=SC2030,SC2031  # subshell-local on purpose: only the
    # tools module reads from the cache, the outer -mod=vendor stands.
    export GOFLAGS="-mod=readonly"
    go mod download
) >&2

for platform in "${TOOLCHAIN_PLATFORMS[@]}"; do
    goos="${platform%/*}"
    goarch="${platform#*/}"
    echo "Collecting build toolchain licenses for ${goos}/${goarch}..." >&2

    platform_save="${TOOLS_SAVE_ROOT}/${goos}_${goarch}"
    (
        cd "${TOOLS_DIR}"
        # shellcheck disable=SC2030,SC2031  # subshell-local, as above.
        export GOFLAGS="-mod=readonly"
        export GOOS="${goos}" GOARCH="${goarch}"
        tools_stdlib=$(go list std 2>/dev/null | cut -d'/' -f1 | LC_ALL=C sort -u | paste -sd ',' -)
        "${GO_LICENSES}" save "${TOOL_PKGS[@]}" \
            --save_path="${platform_save}" \
            --force \
            --ignore="${tools_stdlib}" >&2
        "${GO_LICENSES}" csv "${TOOL_PKGS[@]}" \
            --ignore="${tools_stdlib}"
    ) >> "${TOOLS_CSV}"

    # Own subtree, so a module in both graphs cannot have one copy clobber the
    # other. Module cache files are 0444 and 'cp -R' preserves that, which would
    # make the next platform's copy fail; restore write permission each pass.
    cp -R "${platform_save}/." "${LICENSES_DIR}/.tools/"
    chmod -R u+w "${LICENSES_DIR}/.tools"
done

echo "Generating dependency index..." >&2

# One row per package, joining every license rather than picking one.
#
# go-licenses emits a row PER RECOGNIZED LICENSE, so a library whose license file
# matches several produces several rows — here klauspost/compress, sigs.k8s.io/
# yaml, sigs.k8s.io/json and cyphar/filepath-securejoin. Deduplicating on the
# package field would keep one and drop the rest, hiding filepath-securejoin's
# MPL-2.0 behind its BSD-3-Clause.
#
# It was also non-deterministic: 'sort -k1,1 -u' compares only the key, and BSD
# sort keeps whichever row came first in input order while GNU sort applies a
# whole-line tiebreak, so two hosts could disagree. Sorting whole lines first
# gives a total order, making this collapse depend on content, not input order.
collapse_index() {
    LC_ALL=C sort -u "$1" | awk -F, '
        {
            pkg = $1
            if (!(pkg in url)) { url[pkg] = $2; order[++n] = pkg }
            if (!((pkg SUBSEP $3) in seen)) {
                seen[pkg SUBSEP $3] = 1
                lic[pkg] = (pkg in lic) ? lic[pkg] " / " $3 : $3
            }
        }
        END { for (i = 1; i <= n; i++) print order[i] "," url[order[i]] "," lic[order[i]] }
    '
}

# In vendor mode go-licenses reports a URL into this repo at HEAD, which stops
# describing released content once main moves and names our vendor copy rather
# than upstream. modules.txt has the exact version, so emit module@version
# instead. Longest-prefix match, since a license may sit in a subdirectory whose
# module root is shorter (e.g. klauspost/compress/zstd/internal/xxhash).
MODULES_TXT="${MODULES_TXT:-vendor/modules.txt}"
if [[ ! -f "${MODULES_TXT}" ]]; then
    echo "ERROR: ${MODULES_TXT} not found — run 'make notices' from the repo root." >&2
    exit 1
fi

annotate_modules() {
    awk -v modfile="${MODULES_TXT}" '
        BEGIN {
            FS = OFS = ","
            while ((getline line < modfile) > 0) {
                if (line ~ /^# /) {
                    split(line, f, " ")
                    mods[++m] = f[2]
                    vers[f[2]] = f[3]
                }
            }
            close(modfile)
        }
        {
            best = ""
            for (i = 1; i <= m; i++) {
                mp = mods[i]
                if (($1 == mp || index($1, mp "/") == 1) && length(mp) > length(best)) best = mp
            }
            print $0, (best == "" ? "unknown" : best "@" vers[best])
        }
    '
}

collapse_index "${COMBINED_CSV}" | annotate_modules > "${INDEX_FILE}"
collapse_index "${TOOLS_CSV}" > "${TOOLS_INDEX}"

if [[ ! -s "${INDEX_FILE}" ]]; then
    echo "ERROR: go-licenses produced no entries for ${PACKAGES[*]} — refusing to write empty notices file." >&2
    exit 1
fi
if [[ ! -s "${TOOLS_INDEX}" ]]; then
    echo "ERROR: go-licenses produced no entries for the build toolchain — refusing to write incomplete notices file." >&2
    exit 1
fi

# One '### <pkg>' section per entry. ${3} picks the provenance line: "module" for
# runtime entries (annotated above), "source" for toolchain ones, which resolve
# from the module cache and already carry a versioned upstream URL.
emit_sections() {
    local index="$1" root="$2" provenance="$3"
    local pkg url license module license_files f lf fence

    while IFS=, read -r pkg url license module; do
        [[ -z "${pkg}" ]] && continue

        # A dependency may ship several license files (LICENSE plus NOTICE, or
        # LICENSE-MIT plus LICENSE-APACHE), so emit all of them, sorted, to avoid
        # losing attribution. Filter to license-bearing names: for restricted
        # licenses 'go-licenses save' copies the whole module source, and dumping
        # its README and .go files here is not what a notices file is for — we
        # redistribute those modules unmodified, so upstream is the source.
        license_files=()
        if [[ -d "${root}/${pkg}" ]]; then
            while IFS= read -r -d '' f; do
                if ! printf '%s' "$(basename "${f}")" \
                    | grep -qiE '^(licen[cs]e|notice|copying|copyright|authors|patents)([-._].*)?$'; then
                    continue
                fi
                license_files+=("${f}")
            done < <(find "${root}/${pkg}" -maxdepth 1 -type f -print0 2>/dev/null \
                | LC_ALL=C sort -z)
        fi

        printf '### %s\n\n' "${pkg}"
        printf '* License: %s\n' "${license:-Unknown}"
        if [[ "${provenance}" == "module" ]]; then
            printf '* Module: %s\n\n' "${module:-unknown}"
        else
            printf '* Source: %s\n\n' "${url:-n/a}"
        fi

        if (( ${#license_files[@]} > 0 )); then
            for lf in "${license_files[@]}"; do
                fence="$(fence_for "${lf}")"
                printf '#### %s\n\n' "$(basename "${lf}")"
                printf '%stext\n' "${fence}"
                cat "${lf}"
                echo
                printf '%s\n' "${fence}"
                echo
            done
        else
            printf 'License text unavailable. See upstream source for the full license.\n'
        fi
        echo
    done < "${index}"
}

emit_index_table() {
    local index="$1" provenance="$2" pkg url license module
    if [[ "${provenance}" == "module" ]]; then
        printf '| Package | License | Module |\n'
    else
        printf '| Package | License | Source |\n'
    fi
    printf '|---------|---------|--------|\n'
    while IFS=, read -r pkg url license module; do
        [[ -z "${pkg}" ]] && continue
        # shellcheck disable=SC2016  # backticks are literal markdown here.
        if [[ "${provenance}" == "module" ]]; then
            printf '| `%s` | %s | `%s` |\n' "${pkg}" "${license:-Unknown}" "${module:-unknown}"
        else
            printf '| `%s` | %s | %s |\n' "${pkg}" "${license:-Unknown}" "${url:-n/a}"
        fi
    done < "${index}"
}

echo "Composing ${OUTPUT}..." >&2
{
    cat <<'EOF'
# Third-Party Notices

NVIDIA GPU Operator

This file covers the **Go dependencies** of the GPU Operator, with the verbatim
text of each one's license. Two surfaces are covered:

* **Runtime dependencies** — Go modules statically linked into the commands
  under `cmd/`, resolved as the union across every released image platform.
  Four of those commands — `gpu-operator`, `manage-crds`,
  `cleanup-gpuclusters` and `nvidia-validator` — are copied into the released
  `gpu-operator` image. The fifth, `gpuop-cfg`, is a build-time helper that is
  not shipped; its dependencies are listed here as well rather than excluded.
* **Build toolchain** — Go modules behind the code generators and helpers in
  `tools/go.mod`. These run at build time and are not shipped in the released
  image; they are listed here so the full chain behind the released artifacts
  is attributable.

Go standard library packages are excluded; they are covered by the license of
the Go distribution itself.

Scope: this document does not inventory the non-Go contents of the released
container image — the packages inherited from its base image, the BusyBox tree,
the CUDA sample, or the CUDA compatibility libraries. Base image dependencies
are covered by that image's own compliance process, and the remaining
components are handled separately, including any source-distribution
obligations they carry.

Go runtime entries identify their dependency as `module@version` rather than a
URL. `go-licenses` in vendor mode reports a link into this repository at `HEAD`,
which stops describing the released content once `main` advances;
`module@version` is immutable and names the upstream project directly.

This file is generated. Run `make notices` to regenerate it; `make
notices-check` verifies it is current.

## Runtime Dependency Index

EOF

    emit_index_table "${INDEX_FILE}" module

    cat <<'EOF'

## Build Toolchain Dependency Index

EOF

    emit_index_table "${TOOLS_INDEX}" source

    cat <<'EOF'

## Runtime Dependency License Texts

EOF

    emit_sections "${INDEX_FILE}" "${LICENSES_DIR}" module

    cat <<'EOF'
## Build Toolchain License Texts

EOF

    emit_sections "${TOOLS_INDEX}" "${LICENSES_DIR}/.tools" source
} > "${OUTPUT}"

RUNTIME_ENTRIES=$(wc -l < "${INDEX_FILE}" | tr -d ' ')
TOOLS_ENTRIES=$(wc -l < "${TOOLS_INDEX}" | tr -d ' ')
echo "Wrote ${OUTPUT} (${RUNTIME_ENTRIES} Go runtime modules, ${TOOLS_ENTRIES} toolchain modules)" >&2
